#!/bin/sh
# Managed by Ansible -- emrys_merlin.rpi.rclone. Do not edit on the host.
#
# Runs the rclone compose project once and reports the outcome to an Uptime Kuma
# push monitor. See plans/15-rclone-mount-monitoring.md.
set -u

start=$(date +%s)

{% if rclone_pre_sync_command %}
# The pre-sync hook. Non-zero skips the sync. Under timeout for the same reason
# as compose below: a hung hook must not leave the monitor without an answer.
pre_out=$(timeout -k 30 {{ rclone_job_timeout }} sh -c {{ rclone_pre_sync_command | quote }} 2>&1)
pre_rc=$?

if [ "$pre_rc" -eq 0 ]; then
{% endif %}
# --exit-code-from is load-bearing: plain `docker compose up` exits 0 even when
# the container fails, so without it this script would report success on every
# run -- a monitor that is green precisely when it should be red.
#
# timeout is load-bearing too: a hung rclone would otherwise hang this script
# forever and the monitor would report neither up nor down. -k forces a KILL if
# compose ignores the TERM.
out=$(cd "{{ rclone_location }}" \
      && timeout -k 30 {{ rclone_job_timeout }} \
         docker compose up --exit-code-from rclone 2>&1)
rc=$?
{% if rclone_pre_sync_command %}
else
    rc=$pre_rc
fi
{% endif %}
ms=$(( ($(date +%s) - start) * 1000 ))

{% if rclone_pre_sync_command %}
if [ "$pre_rc" -ne 0 ]; then
    status=down
    pre_msg=$(printf '%s\n' "$pre_out" | tail -n 1 | cut -c 1-300)
    msg="pre-sync: ${pre_msg:-exit $pre_rc}"
elif [ "$rc" -eq 0 ]; then
{% else %}
if [ "$rc" -eq 0 ]; then
{% endif %}
    status=up
    msg="OK"
elif [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    status=down
    msg="timed out after {{ rclone_job_timeout }}s"
else
    status=down
    msg="exit $rc: $(printf '%s' "$out" | tail -c 300 | tr '\n' ' ')"
fi

# No push URL configured -- reporting is simply skipped, so invocations that do
# not monitor are unaffected.
[ -n "{{ rclone_push_url }}" ] || exit "$rc"

# -G --data-urlencode so rclone's error text cannot break the URL.
# --retry so one transient tailnet blip does not raise a false alarm.
curl -fsS -m 15 --retry 3 --retry-delay 5 -G \
     --data-urlencode "status=$status" \
     --data-urlencode "msg=$msg" \
     --data-urlencode "ping=$ms" \
     "{{ rclone_push_url }}" >/dev/null

# Preserve the real outcome for anything reading cron mail.
exit "$rc"
